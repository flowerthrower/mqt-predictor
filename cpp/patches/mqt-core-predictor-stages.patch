+bool QCOProgram::placeAndRoute(const CompilerTarget& target) {
+  return succeeded(runPasses(
+      mod(),
+      [&target](OpPassManager& pm) {
+        populateQCOCleanupPipeline(pm);
+        pm.addPass(qco::createMappingPass(target, qco::MappingPassOptions{}));
+      },
+      "failed to place and route the QCO program"));
+}
+
+bool QCOProgram::synthesizeForTarget(const CompilerTarget& target) {
+  return succeeded(runPasses(
+      mod(),
+      [&target](OpPassManager& pm) {
+        populateQCOCleanupPipeline(pm);
+        pm.addPass(qco::createTargetNativeSynthesis(target));
+        pm.addPass(createCSEPass());
+        pm.addPass(createRemoveDeadValuesPass());
+      },
+      "failed to synthesize the QCO program for the target"));
+}
+
+bool QCOProgram::verifyTargetConformance(const CompilerTarget& target) {
+  return succeeded(runPasses(
+      mod(),
+      [&target](OpPassManager& pm) {
+        pm.addPass(qco::createVerifyTargetConformance(target));
+      },
+      "the QCO program does not conform to the target"));
+}
