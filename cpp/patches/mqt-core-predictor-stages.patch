+
+#include <llvm/ADT/DenseMap.h>
+#include <llvm/ADT/STLExtras.h>
+#include <llvm/ADT/SmallVector.h>
+#include <llvm/ADT/StringMap.h>
+#include <llvm/ADT/StringRef.h>
+#include <mlir/Dialect/Utils/StaticValueUtils.h>
+#include <mlir/IR/BuiltinTypes.h>
+#include <mlir/IR/Operation.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace mlir::qco {
+namespace {
+
+using SiteId = CompilerTarget::SiteId;
+
+struct WireState {
+  size_t logical = 0;
+  std::optional<SiteId> site;
+  size_t depth = 0;
+  size_t twoQubitCriticalDepth = 0;
+};
+
+struct ScoredOperation {
+  Operation* operation = nullptr;
+  std::string name;
+  size_t numQubits = 0;
+  size_t numParameters = 0;
+  SmallVector<std::optional<SiteId>, 2> sites;
+};
+
+[[nodiscard]] bool usesLinearQubit(Operation& operation) {
+  const auto isQubit = [](Value value) {
+    return isLinearQubitType(value.getType());
+  };
+  return llvm::any_of(operation.getOperands(), isQubit) ||
+         llvm::any_of(operation.getResults(), isQubit);
+}
+
+[[nodiscard]] std::optional<llvm::StringRef>
+canonicalOperationName(UnitaryOpInterface unitary) {
+  auto controlled = dyn_cast<CtrlOp>(unitary.getOperation());
+  if (!controlled) {
+    return unitary.getBaseSymbol();
+  }
+  if (controlled.getNumBodyUnitaries() != 1) {
+    return std::nullopt;
+  }
+
+  auto body = controlled.getBodyUnitary(0);
+  const auto base = body.getBaseSymbol();
+  const auto controls = controlled.getNumControls();
+  const auto targets = controlled.getNumTargets();
+  if (controls == 1) {
+    if (targets == 2 && base == "swap") {
+      return "cswap";
+    }
+    if (targets != 1) {
+      return std::nullopt;
+    }
+    if (base == "x") {
+      return "cx";
+    }
+    if (base == "y") {
+      return "cy";
+    }
+    if (base == "z") {
+      return "cz";
+    }
+    if (base == "h") {
+      return "ch";
+    }
+    if (base == "p") {
+      return "cp";
+    }
+    if (base == "rx") {
+      return "crx";
+    }
+    if (base == "ry") {
+      return "cry";
+    }
+    if (base == "rz") {
+      return "crz";
+    }
+    if (base == "sx") {
+      return "csx";
+    }
+    if (base == "u") {
+      return "cu3";
+    }
+    return std::nullopt;
+  }
+  if (targets != 1 || base != "x") {
+    return std::nullopt;
+  }
+  if (controls == 2) {
+    return "ccx";
+  }
+  if (controls == 3) {
+    return "c3x";
+  }
+  if (controls == 4) {
+    return "c4x";
+  }
+  return std::nullopt;
+}
+
+[[nodiscard]] bool sameSites(llvm::ArrayRef<SiteId> lhs,
+                             llvm::ArrayRef<SiteId> rhs) {
+  return lhs.size() == rhs.size() && llvm::equal(lhs, rhs);
+}
+
+[[nodiscard]] std::optional<double>
+operationFidelity(const CompilerTarget& target, const ScoredOperation& scored) {
+  SmallVector<SiteId, 2> sites;
+  sites.reserve(scored.sites.size());
+  for (const auto site : scored.sites) {
+    if (!site) {
+      return std::nullopt;
+    }
+    sites.emplace_back(*site);
+  }
+
+  SmallVector<const CompilerTarget::Operation*> capabilities;
+  for (const auto& operation : target.operations()) {
+    if (operation.canonicalName() == scored.name &&
+        operation.numQubits() == scored.numQubits &&
+        operation.numParameters() == scored.numParameters) {
+      capabilities.emplace_back(&operation);
+    }
+  }
+
+  const auto tupleFidelity = [&](llvm::ArrayRef<SiteId> requested) {
+    for (const auto* capability : capabilities) {
+      const auto tuple =
+          llvm::find_if(capability->siteTuples(),
+                        [&](const CompilerTarget::SiteTuple& candidate) {
+                          return sameSites(candidate.sites(), requested);
+                        });
+      if (tuple != capability->siteTuples().end()) {
+        if (const auto fidelity = tuple->fidelity()) {
+          return fidelity;
+        }
+      }
+    }
+    return std::optional<double>{};
+  };
+  if (const auto fidelity = tupleFidelity(sites)) {
+    return fidelity;
+  }
+
+  if (scored.name == "cz" && sites.size() == 2) {
+    std::ranges::reverse(sites);
+    if (const auto fidelity = tupleFidelity(sites)) {
+      return fidelity;
+    }
+  }
+  for (const auto* capability : capabilities) {
+    if (const auto fidelity = capability->fidelity()) {
+      return fidelity;
+    }
+  }
+  return std::nullopt;
+}
+
+} // namespace
+
+namespace detail {
+
+struct QCOCircuitStatistics {
+  bool valid = false;
+  size_t numQubits = 0;
+  size_t dynamicRoots = 0;
+  size_t staticRoots = 0;
+  size_t depth = 0;
+  size_t twoQubitDepth = 0;
+  size_t numGates = 0;
+  size_t numTwoQubitGates = 0;
+  size_t totalOperations = 0;
+  size_t activity = 0;
+  bool hasWideUnitary = false;
+  llvm::StringMap<size_t> operationCounts;
+  std::set<std::pair<size_t, size_t>> logicalInteractions;
+  std::set<SiteId> staticSites;
+  std::vector<std::pair<SiteId, SiteId>> physicalInteractions;
+  std::vector<ScoredOperation> scoredOperations;
+};
+
+} // namespace detail
+
+namespace {
+
+[[nodiscard]] std::shared_ptr<const detail::QCOCircuitStatistics>
+scanCircuit(ModuleOp moduleOp) {
+  auto statistics = std::make_shared<detail::QCOCircuitStatistics>();
+  auto entry = mqt::getEntryPoint(moduleOp);
+  if (!entry || !entry.getBody().hasOneBlock() ||
+      llvm::any_of(entry.getArgumentTypes(), isLinearQubitType)) {
+    return statistics;
+  }
+
+  llvm::DenseMap<Value, WireState> wires;
+  using TensorState = SmallVector<std::optional<WireState>>;
+  llvm::DenseMap<Value, TensorState> tensors;
+  size_t nextLogical = 0;
+
+  const auto recordDepth = [&](const WireState& wire) {
+    if (wire.depth >= statistics->depth) {
+      statistics->depth = wire.depth;
+      statistics->twoQubitDepth = wire.twoQubitCriticalDepth;
+    }
+  };
+  const auto advanceWire = [&](Value input, Value output, bool isTwoQubit,
+                               size_t operationDepth,
+                               size_t operationCriticalDepth) {
+    const auto found = wires.find(input);
+    if (found == wires.end()) {
+      return false;
+    }
+    auto next = found->second;
+    wires.erase(found);
+    next.depth = operationDepth;
+    next.twoQubitCriticalDepth =
+        operationCriticalDepth + static_cast<size_t>(isTwoQubit);
+    wires[output] = next;
+    recordDepth(next);
+    return true;
+  };
+
+  for (Operation& operation : entry.getBody().front()) {
+    if (auto alloc = dyn_cast<AllocOp>(operation)) {
+      wires[alloc.getResult()] = WireState{.logical = nextLogical++};
+      ++statistics->dynamicRoots;
+      continue;
+    }
+    if (auto staticQubit = dyn_cast<StaticOp>(operation)) {
+      const auto site = static_cast<SiteId>(staticQubit.getIndex());
+      if (!statistics->staticSites.insert(site).second) {
+        return statistics;
+      }
+      wires[staticQubit.getQubit()] =
+          WireState{.logical = nextLogical++, .site = site};
+      ++statistics->staticRoots;
+      continue;
+    }
+    if (auto alloc = dyn_cast<qtensor::AllocOp>(operation)) {
+      const auto type = dyn_cast<RankedTensorType>(alloc.getResult().getType());
+      if (!type || !type.hasStaticShape() || type.getRank() != 1) {
+        return statistics;
+      }
+      const auto size = static_cast<size_t>(type.getDimSize(0));
+      TensorState tensor(size);
+      for (auto& wire : tensor) {
+        wire = WireState{.logical = nextLogical++};
+      }
+      tensors[alloc.getResult()] = std::move(tensor);
+      statistics->dynamicRoots += size;
+      continue;
+    }
+    if (auto fromElements = dyn_cast<qtensor::FromElementsOp>(operation)) {
+      TensorState tensor;
+      tensor.reserve(fromElements.getElements().size());
+      for (auto element : fromElements.getElements()) {
+        const auto found = wires.find(element);
+        if (found == wires.end()) {
+          return statistics;
+        }
+        tensor.emplace_back(found->second);
+        wires.erase(found);
+      }
+      tensors[fromElements.getResult()] = std::move(tensor);
+      continue;
+    }
+    if (auto extract = dyn_cast<qtensor::ExtractOp>(operation)) {
+      const auto index = getConstantIntValue(extract.getIndex());
+      const auto found = tensors.find(extract.getTensor());
+      if (!index || *index < 0 || found == tensors.end() ||
+          std::cmp_greater_equal(*index, found->second.size())) {
+        return statistics;
+      }
+      auto tensor = std::move(found->second);
+      tensors.erase(found);
+      auto& wire = tensor[static_cast<size_t>(*index)];
+      if (!wire) {
+        return statistics;
+      }
+      wires[extract.getResult()] = *wire;
+      wire.reset();
+      tensors[extract.getOutTensor()] = std::move(tensor);
+      continue;
+    }
+    if (auto insert = dyn_cast<qtensor::InsertOp>(operation)) {
+      const auto index = getConstantIntValue(insert.getIndex());
+      const auto tensorFound = tensors.find(insert.getDest());
+      const auto wireFound = wires.find(insert.getScalar());
+      if (!index || *index < 0 || tensorFound == tensors.end() ||
+          wireFound == wires.end() ||
+          std::cmp_greater_equal(*index, tensorFound->second.size())) {
+        return statistics;
+      }
+      auto tensor = std::move(tensorFound->second);
+      tensors.erase(tensorFound);
+      auto& slot = tensor[static_cast<size_t>(*index)];
+      if (slot) {
+        return statistics;
+      }
+      slot = wireFound->second;
+      wires.erase(wireFound);
+      tensors[insert.getResult()] = std::move(tensor);
+      continue;
+    }
+    if (auto dealloc = dyn_cast<qtensor::DeallocOp>(operation)) {
+      const auto found = tensors.find(dealloc.getTensor());
+      if (found == tensors.end()) {
+        return statistics;
+      }
+      tensors.erase(found);
+      continue;
+    }
+    if (auto sink = dyn_cast<SinkOp>(operation)) {
+      const auto found = wires.find(sink.getQubit());
+      if (found == wires.end()) {
+        return statistics;
+      }
+      wires.erase(found);
+      continue;
+    }
+
+    if (auto unitary = dyn_cast<UnitaryOpInterface>(operation)) {
+      if (isa<BarrierOp, GPhaseOp>(operation)) {
+        for (auto [input, output] : llvm::zip_equal(
+                 unitary.getInputQubits(), unitary.getOutputQubits())) {
+          const auto found = wires.find(input);
+          if (found == wires.end()) {
+            return statistics;
+          }
+          const auto next = found->second;
+          wires.erase(found);
+          wires[output] = next;
+        }
+        continue;
+      }
+
+      ++statistics->totalOperations;
+      const auto operationName = canonicalOperationName(unitary);
+      if (operationName) {
+        ++statistics->operationCounts[*operationName];
+      }
+
+      const auto arity = unitary.getNumQubits();
+      if (arity == 0 || operation.getNumRegions() > 1) {
+        return statistics;
+      }
+
+      auto numParameters = unitary.getNumParams();
+      if (auto controlled = dyn_cast<CtrlOp>(operation);
+          controlled && controlled.getNumBodyUnitaries() == 1) {
+        numParameters = controlled.getBodyUnitary(0).getNumParams();
+      }
+
+      size_t operationDepth = 0;
+      size_t operationCriticalDepth = 0;
+      ScoredOperation scored{.operation = &operation,
+                             .name = operationName ? operationName->str() : "",
+                             .numQubits = arity,
+                             .numParameters = numParameters};
+      scored.sites.reserve(arity);
+      for (auto input : unitary.getInputQubits()) {
+        const auto found = wires.find(input);
+        if (found == wires.end()) {
+          return statistics;
+        }
+        scored.sites.emplace_back(found->second.site);
+        if (found->second.depth > operationDepth) {
+          operationDepth = found->second.depth;
+          operationCriticalDepth = found->second.twoQubitCriticalDepth;
+        }
+      }
+      ++operationDepth;
+
+      const auto isTwoQubit = arity == 2;
+      statistics->hasWideUnitary |= arity > 2;
+      ++statistics->numGates;
+      statistics->numTwoQubitGates += static_cast<size_t>(isTwoQubit);
+      statistics->activity += arity;
+
+      if (isTwoQubit) {
+        const auto first = wires.find(unitary.getInputQubit(0));
+        const auto second = wires.find(unitary.getInputQubit(1));
+        if (first == wires.end() || second == wires.end()) {
+          return statistics;
+        }
+        const auto edge =
+            std::minmax(first->second.logical, second->second.logical);
+        statistics->logicalInteractions.emplace(edge.first, edge.second);
+        if (first->second.site && second->second.site) {
+          statistics->physicalInteractions.emplace_back(*first->second.site,
+                                                        *second->second.site);
+        }
+      }
+      statistics->scoredOperations.emplace_back(std::move(scored));
+
+      for (auto [input, output] : llvm::zip_equal(unitary.getInputQubits(),
+                                                  unitary.getOutputQubits())) {
+        if (!advanceWire(input, output, isTwoQubit, operationDepth,
+                         operationCriticalDepth)) {
+          return statistics;
+        }
+      }
+      continue;
+    }
+
+    if (auto measure = dyn_cast<MeasureOp>(operation)) {
+      const auto found = wires.find(measure.getQubitIn());
+      if (found == wires.end()) {
+        return statistics;
+      }
+      ++statistics->totalOperations;
+      ++statistics->operationCounts["measure"];
+      ++statistics->activity;
+      statistics->scoredOperations.emplace_back(ScoredOperation{
+          .operation = &operation,
+          .name = "measure",
+          .numQubits = 1,
+          .numParameters = 0,
+          .sites = {found->second.site},
+      });
+      if (!advanceWire(measure.getQubitIn(), measure.getQubitOut(), false,
+                       found->second.depth + 1,
+                       found->second.twoQubitCriticalDepth)) {
+        return statistics;
+      }
+      continue;
+    }
+
+    if (auto reset = dyn_cast<ResetOp>(operation)) {
+      const auto found = wires.find(reset.getQubitIn());
+      if (found == wires.end()) {
+        return statistics;
+      }
+      ++statistics->totalOperations;
+      ++statistics->operationCounts["reset"];
+      ++statistics->activity;
+      statistics->scoredOperations.emplace_back(ScoredOperation{
+          .operation = &operation,
+          .name = "reset",
+          .numQubits = 1,
+          .numParameters = 0,
+          .sites = {found->second.site},
+      });
+      if (!advanceWire(reset.getQubitIn(), reset.getQubitOut(), false,
+                       found->second.depth + 1,
+                       found->second.twoQubitCriticalDepth)) {
+        return statistics;
+      }
+      continue;
+    }
+
+    if (operation.getNumRegions() != 0 || usesLinearQubit(operation)) {
+      return statistics;
+    }
+  }
+
+  if (!wires.empty() || !tensors.empty() || nextLogical == 0) {
+    return statistics;
+  }
+  statistics->numQubits = nextLogical;
+  statistics->valid = true;
+  return statistics;
+}
