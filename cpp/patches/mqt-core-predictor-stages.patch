+class QCOCircuitMetrics:
+    """Owned target-relative metrics for a straight-line QCO circuit."""
+
+    @property
+    def operation_counts(self) -> dict:
+        """Canonical operation counts in the circuit."""
+
+    @property
+    def total_operations(self) -> int:
+        """The non-barrier operation count."""
+
+    @property
+    def num_qubits(self) -> int:
+        """The target-effective qubit count."""
+
+    @property
+    def depth(self) -> int:
+        """The circuit depth."""
+
+    @property
+    def two_qubit_depth(self) -> int:
+        """The two-qubit depth along the critical path."""
+
+    @property
+    def num_gates(self) -> int:
+        """The unitary gate count."""
+
+    @property
+    def num_two_qubit_gates(self) -> int:
+        """The two-qubit unitary gate count."""
+
+    @property
+    def program_communication(self) -> float:
+        """The normalized logical interaction density."""
+
+    @property
+    def critical_depth(self) -> float:
+        """The fraction of two-qubit gates on the critical path."""
+
+    @property
+    def entanglement_ratio(self) -> float:
+        """The fraction of unitary gates acting on two qubits."""
+
+    @property
+    def parallelism(self) -> float:
+        """The normalized circuit parallelism."""
+
+    @property
+    def liveness(self) -> float:
+        """The average active-qubit fraction over circuit depth."""
+
+    @property
+    def mapped(self) -> bool:
+        """Whether every qubit has a static target site."""
+
+    @property
+    def routed(self) -> bool:
+        """Whether every two-qubit gate acts on adjacent target sites."""
+
+    @property
+    def synthesized(self) -> bool:
+        """Whether every operation is native to the target."""
+
+    @property
+    def has_wide_unitary(self) -> bool:
+        """Whether the circuit contains a unitary wider than two qubits."""
+
+    @property
+    def fully_unmapped(self) -> bool:
+        """Whether every qubit originates from a dynamic allocation."""
+
