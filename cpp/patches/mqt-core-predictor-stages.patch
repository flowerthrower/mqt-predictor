+
+QCOCircuitAnalysis::QCOCircuitAnalysis(ModuleOp moduleOp)
+    : statistics_(scanCircuit(moduleOp)) {}
+
+FailureOr<QCOCircuitMetrics>
+QCOCircuitAnalysis::forTarget(const CompilerTarget& target) const {
+  if (!statistics_->valid ||
+      llvm::any_of(statistics_->staticSites, [&](SiteId site) {
+        return !target.vertexForSite(site).has_value();
+      })) {
+    return failure();
+  }
+
+  const auto mapped = statistics_->dynamicRoots == 0 &&
+                      statistics_->staticRoots == statistics_->numQubits;
+  const auto featureQubits =
+      mapped ? target.numQubits() : statistics_->numQubits;
+  if (featureQubits == 0) {
+    return failure();
+  }
+
+  auto routed = mapped;
+  for (const auto [firstSite, secondSite] : statistics_->physicalInteractions) {
+    const auto first = target.vertexForSite(firstSite);
+    const auto second = target.vertexForSite(secondSite);
+    routed &= first && second && target.areAdjacent(*first, *second);
+  }
+  const auto synthesized = llvm::all_of(
+      statistics_->scoredOperations, [&](const ScoredOperation& operation) {
+        return target.supports(operation.operation);
+      });
+
+  const auto communication =
+      featureQubits > 1
+          ? (2. *
+             static_cast<double>(statistics_->logicalInteractions.size())) /
+                (static_cast<double>(featureQubits) *
+                 static_cast<double>(featureQubits - 1))
+          : 0.;
+  const auto criticalDepth =
+      statistics_->numTwoQubitGates > 0
+          ? static_cast<double>(statistics_->twoQubitDepth) /
+                static_cast<double>(statistics_->numTwoQubitGates)
+          : 0.;
+  const auto entanglement =
+      statistics_->numGates > 0
+          ? static_cast<double>(statistics_->numTwoQubitGates) /
+                static_cast<double>(statistics_->numGates)
+          : 0.;
+  const auto parallelism =
+      featureQubits > 1 && statistics_->depth > 0
+          ? std::max(((static_cast<double>(statistics_->numGates) /
+                       static_cast<double>(statistics_->depth)) -
+                      1.) /
+                         static_cast<double>(featureQubits - 1),
+                     0.)
+          : 0.;
+  const auto liveness = statistics_->depth > 0
+                            ? static_cast<double>(statistics_->activity) /
+                                  (static_cast<double>(featureQubits) *
+                                   static_cast<double>(statistics_->depth))
+                            : 0.;
+
+  std::vector<std::pair<std::string, size_t>> operationCounts;
+  operationCounts.reserve(statistics_->operationCounts.size());
+  for (const auto& operation : statistics_->operationCounts) {
+    operationCounts.emplace_back(operation.getKey().str(),
+                                 operation.getValue());
+  }
+  std::ranges::sort(operationCounts, {},
+                    &decltype(operationCounts)::value_type::first);
+
+  return QCOCircuitMetrics{
+      .operationCounts = std::move(operationCounts),
+      .totalOperations = statistics_->totalOperations,
+      .numQubits = featureQubits,
+      .depth = statistics_->depth,
+      .twoQubitDepth = statistics_->twoQubitDepth,
+      .numGates = statistics_->numGates,
+      .numTwoQubitGates = statistics_->numTwoQubitGates,
+      .programCommunication = communication,
+      .criticalDepth = criticalDepth,
+      .entanglementRatio = entanglement,
+      .parallelism = parallelism,
+      .liveness = liveness,
+      .mapped = mapped,
+      .routed = routed,
+      .synthesized = synthesized,
+      .hasWideUnitary = statistics_->hasWideUnitary,
+      .fullyUnmapped = statistics_->dynamicRoots == statistics_->numQubits,
+  };
+}
+
+FailureOr<double>
+QCOCircuitAnalysis::expectedFidelity(const CompilerTarget& target) const {
+  if (!statistics_->valid || statistics_->dynamicRoots != 0 ||
+      statistics_->staticRoots != statistics_->numQubits ||
+      llvm::any_of(statistics_->staticSites, [&](SiteId site) {
+        return !target.vertexForSite(site).has_value();
+      })) {
+    return failure();
+  }
+
+  double fidelity = 1.;
+  for (const auto& scored : statistics_->scoredOperations) {
+    if ((scored.numQubits != 1 && scored.numQubits != 2) ||
+        scored.name.empty()) {
+      return failure();
+    }
+    SmallVector<size_t, 2> vertices;
+    vertices.reserve(scored.sites.size());
+    for (const auto site : scored.sites) {
+      if (!site) {
+        return failure();
+      }
+      const auto vertex = target.vertexForSite(*site);
+      if (!vertex) {
+        return failure();
+      }
+      vertices.emplace_back(*vertex);
+    }
+    if (vertices.size() == 2 && !target.areAdjacent(vertices[0], vertices[1])) {
+      return failure();
+    }
+    const auto operation = operationFidelity(target, scored);
+    if (!operation) {
+      return failure();
+    }
+    fidelity *= 1. - (1. - *operation);
+  }
+
+  constexpr double precision = 10'000'000'000.;
+  return std::nearbyint(fidelity * precision) / precision;
+}
