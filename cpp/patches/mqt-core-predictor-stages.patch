+#pragma once
+
+#include <mlir/IR/BuiltinOps.h>
+#include <mlir/Support/LogicalResult.h>
+
+#include <cstddef>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace mlir {
+
+class CompilerTarget;
+
+namespace qco {
+
+namespace detail {
+struct QCOCircuitStatistics;
+} // namespace detail
+
+/**
+ * @brief Target-relative metrics for a straight-line QCO circuit.
+ */
+struct QCOCircuitMetrics {
+  std::vector<std::pair<std::string, size_t>> operationCounts;
+  size_t totalOperations = 0;
+  size_t numQubits = 0;
+  size_t depth = 0;
+  size_t twoQubitDepth = 0;
+  size_t numGates = 0;
+  size_t numTwoQubitGates = 0;
+  double programCommunication = 0.;
+  double criticalDepth = 0.;
+  double entanglementRatio = 0.;
+  double parallelism = 0.;
+  double liveness = 0.;
+  bool mapped = false;
+  bool routed = false;
+  bool synthesized = false;
+  bool hasWideUnitary = false;
+  bool fullyUnmapped = false;
+};
+
+/**
+ * @brief Cached structural analysis of a straight-line QCO circuit.
+ *
+ * @details The constructor records target-independent circuit statistics.
+ * Materialization applies a compiler target without rescanning the IR. Normal
+ * MLIR analysis invalidation discards cached operation references after a
+ * transforming pass.
+ */
+class QCOCircuitAnalysis {
+public:
+  explicit QCOCircuitAnalysis(ModuleOp moduleOp);
+
+  /// Materialize target-relative circuit metrics.
+  [[nodiscard]] FailureOr<QCOCircuitMetrics>
+  forTarget(const CompilerTarget& target) const;
+
+  /**
+   * Compute the expected fidelity of a mapped, calibrated circuit.
+   *
+   * This deliberately remains separate from @ref forTarget so unavailable
+   * calibration data cannot prevent intermediate feature extraction.
+   */
+  [[nodiscard]] FailureOr<double>
+  expectedFidelity(const CompilerTarget& target) const;
+
+private:
+  std::shared_ptr<const detail::QCOCircuitStatistics> statistics_;
+};
+
+} // namespace qco
+} // namespace mlir
